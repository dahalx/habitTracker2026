
name: Build Android APK

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # 1. This step downloads your repository code into the runner (Fixes the error)
      - name: Checkout repository
        uses: actions/checkout@v4

      # 2. Set up Java (required to compile Android apps)
      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      # 3. Set up the Flutter SDK
      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: 'stable'
          cache: true

      # 4. Install your app's package dependencies
      - name: Install dependencies
        run: flutter pub get

      # 5. Compile your app into a release APK
      - name: Build APK
        run: flutter build apk --release

      # 6. Save the compiled APK to GitHub Actions Artifacts
      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-release
          path: build/app/outputs/flutter-apk/app-release.apk